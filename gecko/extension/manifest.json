{
  "manifest_version": 2,
  "name": "lem frames",
  "version": "0.1",
  "description": "show web pages inside lem windows",
  "browser_specific_settings": { "gecko": { "id": "lem-frames@lem" } },
  "permissions": ["webRequest", "webRequestBlocking", "webNavigation", "tabs", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["top.js"], "run_at": "document_start" },
    { "matches": ["<all_urls>"],
      "js": ["frame.js"], "run_at": "document_start", "all_frames": true }
  ]
}
